@model HR_PAYROLL_V2.Models.Leave.LeaveTypeViewModel
@{
    ViewData["Title"] = "Add Leave Type";
}
<div class="page-head"><div><h2>Add Leave Type</h2><p>Create a new leave policy.</p></div></div>
<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_Form", Model)
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Leave Type</button>
            </div>
        </form>
    </div>
</div>
