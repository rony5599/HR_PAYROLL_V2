@model HR_PAYROLL_V2.Models.Payroll.SalaryComponentViewModel
@{
    ViewData["Title"] = "Add Salary Component";
}
<div class="page-head"><div><h2>Add Salary Component</h2><p>Define a reusable earning or deduction.</p></div></div>
<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_Form", Model)
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Component</button>
            </div>
        </form>
    </div>
</div>
