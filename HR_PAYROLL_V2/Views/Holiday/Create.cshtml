@model HR_PAYROLL_V2.Models.Company.HolidayViewModel
@{
    ViewData["Title"] = "Add Holiday";
}
<div class="page-head"><div><h2>Add Holiday</h2><p>Publish a new holiday calendar entry.</p></div></div>
<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_Form", Model)
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Holiday</button>
            </div>
        </form>
    </div>
</div>
