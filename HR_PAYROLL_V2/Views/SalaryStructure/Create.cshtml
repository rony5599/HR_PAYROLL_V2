@model HR_PAYROLL_V2.Models.Payroll.SalaryStructureViewModel
@{
    ViewData["Title"] = "New Salary Structure";
}
<div class="page-head"><div><h2>New Salary Structure</h2><p>Combine salary components into a reusable structure.</p></div></div>
<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_Form", Model)
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Salary Structure</button>
            </div>
        </form>
    </div>
</div>
