@model HR_PAYROLL_V2.Models.Shift.ShiftViewModel
@{
    ViewData["Title"] = "Add Shift";
}
<div class="page-head"><div><h2>Add Shift</h2><p>Define a new shift policy.</p></div></div>
<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_Form", Model)
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Shift Policy</button>
            </div>
        </form>
    </div>
</div>
