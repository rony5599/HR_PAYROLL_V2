@model List<HR_PAYROLL_V2.Models.Organogram.OrgNode>
@{
    ViewData["Title"] = "Organogram";
}
<div class="page-head">
    <div>
        <h2>Organogram</h2>
        <p>Automatically generated from the active employee reporting-manager hierarchy.</p>
    </div>
</div>

<div class="panel">
    <div class="org-wrap">
        @if (!Model.Any())
        {
            <p style="text-align:center;color:var(--muted)">No employees found. Add employees and assign reporting managers to build the organogram.</p>
        }
        else
        {
            foreach (var root in Model)
            {
                @await Html.PartialAsync("_OrgNode", root)
            }
        }
    </div>
</div>
