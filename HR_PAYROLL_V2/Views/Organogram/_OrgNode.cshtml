@model HR_PAYROLL_V2.Models.Organogram.OrgNode
<div class="org-tree-node">
    <div class="org-card" style="width:220px">
        <div class="org-photo">@(Model.Name.Length > 0 ? Model.Name.Substring(0, Math.Min(2, Model.Name.Length)).ToUpper() : "?")</div>
        <h4><a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId" style="color:inherit;text-decoration:none">@Model.Name</a></h4>
        <p>@(Model.Designation ?? "No designation")</p>
        <p>@(Model.Department ?? "Unassigned")</p>
    </div>
    @if (Model.Reports.Any())
    {
        <div class="org-tree-children">
            @foreach (var child in Model.Reports)
            {
                @await Html.PartialAsync("_OrgNode", child)
            }
        </div>
    }
</div>
