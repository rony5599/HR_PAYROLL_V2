@model IReadOnlyList<HR_PAYROLL_V2.Domain.Entities.Company>
@{
    ViewData["Title"] = "Companies";
}
<div class="page-head">
    <div>
        <h2>Companies</h2>
        <p>Manage the companies operating under this HRMS installation.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Add Company</a>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Company</th><th>Code</th><th>Currency</th><th>Frequency</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var company in Model)
            {
                <tr>
                    <td><strong>@company.Name</strong></td>
                    <td>@company.Code</td>
                    <td>@company.PayrollCurrency</td>
                    <td>@company.PayrollFrequency</td>
                    <td><span class="status @(company.IsActive ? "s-success" : "s-neutral")">@(company.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@company.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@company.Id" method="post" style="display:inline">
                            <button class="btn btn-danger btn-sm" type="submit" onclick="return confirm('Remove this company?');">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
