@model HR_PAYROLL_V2.Models.Auth.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - PeopleFlow HRMS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="min-height:100vh;display:grid;place-items:center;background:var(--bg)">
    <div class="panel" style="width:min(420px,92vw);padding:28px">
        <div class="brand" style="border:0;padding:0;margin-bottom:22px;color:var(--text)">
            <div class="brand-mark">PF</div>
            <div>
                <h1 style="color:var(--text)">PeopleFlow HRMS</h1>
                <span style="color:var(--muted)">Sign in to your workspace</span>
            </div>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="notice" style="background:#fef2f2;border-color:#fecaca;color:#b91c1c"></div>
            <div class="field" style="margin-bottom:14px">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" placeholder="admin" autofocus />
            </div>
            <div class="field" style="margin-bottom:20px">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="••••••••" />
            </div>
            <button class="btn btn-primary" type="submit" style="width:100%">Sign in</button>
        </form>
        <p style="color:var(--muted);font-size:12px;margin-top:16px">Default seeded account: <strong>admin</strong> / <strong>Admin@123</strong></p>
    </div>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
