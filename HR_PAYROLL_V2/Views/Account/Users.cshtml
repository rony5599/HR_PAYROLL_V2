@model IReadOnlyList<HR_PAYROLL_V2.Domain.Entities.User>
@{
    ViewData["Title"] = "Users & Roles";
}
<div class="page-head">
    <div>
        <h2>Users &amp; Roles</h2>
        <p>System accounts that can sign in to PeopleFlow HRMS.</p>
    </div>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Username</th><th>Email</th><th>Status</th><th>Last Login</th></tr></thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td><span class="status @(user.IsActive ? "s-success" : "s-neutral")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@(user.LastLoginAt?.ToString("g") ?? "Never")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
