@model HR_PAYROLL_V2.Models.Payroll.PayrollPeriodViewModel
@{
    ViewData["Title"] = "New Payroll Period";
}
<div class="page-head"><div><h2>New Payroll Period</h2><p>Define the date range to calculate payroll for.</p></div></div>
<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="notice" style="background:#fef2f2;border-color:#fecaca;color:#b91c1c"></div>
            <div class="form-grid">
                <div class="field"><label asp-for="CompanyId">Company</label><select asp-for="CompanyId" asp-items="ViewBag.Companies"></select></div>
                <div class="field"><label asp-for="Name">Period name</label><input asp-for="Name" placeholder="Example: August 2026" /></div>
                <div class="field"><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" /></div>
                <div class="field"><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" /></div>
                <div class="field"><label asp-for="PaymentDate"></label><input asp-for="PaymentDate" type="date" /></div>
            </div>
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Create Period</button>
            </div>
        </form>
    </div>
</div>
