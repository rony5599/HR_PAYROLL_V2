@model HR_PAYROLL_V2.Models.Attendance.ManualAttendanceViewModel
@{
    ViewData["Title"] = "Manual Attendance";
}
<div class="page-head"><div><h2>Manual Attendance Entry</h2><p>Status, worked hours, and late/early minutes are calculated automatically from the employee's assigned shift.</p></div></div>

<div class="panel">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="notice" style="background:#fef2f2;border-color:#fecaca;color:#b91c1c"></div>
            <div class="form-grid">
                <div class="field"><label asp-for="EmployeeId">Employee</label><select asp-for="EmployeeId" asp-items="ViewBag.Employees"></select></div>
                <div class="field"><label asp-for="AttendanceDate"></label><input asp-for="AttendanceDate" type="date" /></div>
                <div class="field"><label asp-for="CheckIn"></label><input asp-for="CheckIn" type="time" /></div>
                <div class="field"><label asp-for="CheckOut"></label><input asp-for="CheckOut" type="time" /></div>
                <div class="field full"><label asp-for="Remarks"></label><textarea asp-for="Remarks" placeholder="Example: Biometric device was offline during check-in."></textarea></div>
            </div>
            <div class="setup-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Attendance</button>
            </div>
        </form>
    </div>
</div>
